{
  "name": "blastserver",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">= v24.4.1"
  },
  "scripts": {
    "dev:app": "ENV_FILE='./.env.development' next dev --turbopack",
    "dev:infra": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d postgres migrate blastworker downloadworker --build",
    "dev:infra:down": "docker compose -f docker-compose.yml -f docker-compose.dev.yml down",
    "build:app:dev": "rm -rf .next && ENV_FILE='./.env.development' next build && ls -lah .next && cp -r .next/static .next/standalone/.next/static",
    "build:app:prod": "rm -rf .next && ENV_FILE='./.env.production' next build && cp -r .next/static .next/standalone/.next/static",
    "build:worker": "rm -rf worker/build && npx tsc -p tsconfig.worker.json",
    "migrate:deploy": "node scripts/migrate-and-seed.js",
    "start:app": "node -r dotenv/config app.js",
    "dev:worker": "run-p dev:blastworker dev:downloadworker",
    "dev:blastworker": "HEALTH_PORT=8080 node -r dotenv/config worker/build/worker/blastworker.js dotenv_config_path=./.env.development",
    "dev:downloadworker": "HEALTH_PORT=8081 node -r dotenv/config worker/build/worker/downloadworker.js dotenv_config_path=./.env.development",
    "start:worker": "run-p start:blastworker start:downloadworker",
    "start:blastworker": "node -r dotenv/config worker/build/worker/blastworker.js",
    "start:downloadworker": "node -r dotenv/config worker/build/worker/downloadworker.js",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:integration": "jest --config jest.integration.config.mjs --runInBand"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.1",
    "@prisma/client": "6.13.0",
    "@react-hook/window-size": "^3.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "d3": "^7.9.0",
    "dotenv": "^17.2.1",
    "lodash": "^4.17.21",
    "lucide-react": "^1.17.0",
    "next": "^15.4.6",
    "next-themes": "^0.4.6",
    "object-hash": "^3.0.0",
    "pg-boss": "^12.18.2",
    "radix-ui": "^1.4.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.62.0",
    "shadcn": "^4.10.0",
    "sonner": "^2.0.7",
    "swr": "^2.3.6",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "xml-js": "^1.6.11",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3": "^7.4.3",
    "@types/file-saver": "^2.0.7",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.20",
    "@types/node": "^24.2.1",
    "@types/object-hash": "^3.0.6",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/wicg-file-system-access": "^2023.10.6",
    "eslint": "^9.33.0",
    "eslint-config-next": "^15.4.6",
    "file-saver": "^2.0.5",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.15",
    "prisma": "6.13.0",
    "supports-color": "^10.1.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.2"
  }
}
