# Copy to .env.development (local host dev) and fill in. In Compose the values
# are set inline in docker-compose.yml. Nothing here is baked into the images.

# --- Database (Postgres / Prisma) ---
# Used by the app, the workers, and the migrate step.
DATABASE_URL='postgresql://USER:PASSWORD@HOST:5432/blastserver?schema=public'
# Only needed where Postgres itself is started (Compose Postgres):
POSTGRES_USER='postgres'
POSTGRES_PASSWORD='change-me'
POSTGRES_DB='blastserver'

# --- Job queue (Redis / BullMQ) ---
JOBQUEUE_HOST='localhost'   # service name (`redis`) in Compose
JOBQUEUE_PORT='6379'

# --- BLAST (workers only) ---
# Directory that holds the BLAST databases on disk (inside the worker).
APP_BLAST_DB_PATH='/blastdb'
# `-num_threads` passed to each BLAST invocation.
NUM_BLAST_THREADS='4'
# Optional cap (bytes) on spawnSync output buffer. Defaults to 512 MB.
# BLAST_MAX_BUFFER='536870912'
# Optional BullMQ stalled-job lock in ms. Defaults to 30 min.
# BLAST_LOCK_DURATION_MS='1800000'
# Optional health-probe port for the worker process. Defaults to 8080.
# HEALTH_PORT='8080'

# --- Taxonomy seed (migrate step only) ---
# Path to the NCBI taxonomy TSV *as seen by the Postgres server* (COPY runs
# server-side). In Compose this file is mounted into the Postgres container.
TAXONOMY_FILE='/app/taxonomy/taxonomy.tsv'

# --- App ---
APP_PORT='3000'             # host port to publish in Compose
NEXT_TELEMETRY_DISABLED='1'
# Sub-path the app is served under (baked at build via --build-arg). Leave empty
# for root.
BASE_PATH=''
NEXT_PUBLIC_BASE_PATH=''
# Comma-separated origin allowlist for /api CORS (empty = same-origin only).
CORS_ALLOW_ORIGIN=''

# --- Compose-only convenience (interpolation defaults) ---
# NAME='blastserver'        # compose project name
# BLAST_DB_PATH='./blastdb' # host path bind-mounted to APP_BLAST_DB_PATH
