/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/worker/build*

# generated Prisma client (run `npm run generate`; build/dev scripts do it too)
/src/generated

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# vscode
.vscode

# Swappable test datasets (gitignored): BLAST DBs + cluster metadata (landmark,
# clustered_nr subset) that production replaces with the full NCBI DBs. The
# clustered_nr fixture under testdata/ is regenerated with
# scripts/make-clustered-fixture.py.
/testdata/
# Full NCBI taxonomy (dumps + Postgres seed) — always used by the app, every env.
/taxonomy/
names.tsv

# python bytecode from scripts/
__pycache__/

# env files (local, never committed) — but keep the documented template
.env*
!.env.example

xmas
