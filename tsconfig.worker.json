{
  "compilerOptions": {
    "outDir": "./worker/build",
    "target": "es2022",
    "lib": ["esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    // esnext module (was es6) so the Prisma 7 ESM client's `import.meta`
    // compiles; node resolution stays lenient about the generated imports.
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": false,
    "incremental": false,
    "paths": {
      "@/*": ["./worker/*"]
    }
  },
  "include": ["worker/*worker.ts"],
  "exclude": ["node_modules"]
}
