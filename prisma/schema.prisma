// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  // Emit explicit .js extensions on the generated client's internal imports so
  // the worker (compiled by tsc and run as raw Node ESM) can resolve them; Next
  // bundles the same files for the app without issue.
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: the connection URL lives in prisma.config.ts; the runtime client
  // connects via the @prisma/adapter-pg driver adapter (see src/app/api/database.ts).
}

model blastjob {
  id         String    @id @unique
  parameters Json
  submitted  DateTime
  started    DateTime?
  finished   DateTime?
  results    String?   @db.Xml
  log        String?
  err        String?
}

model taxonomy {
  // NCBI taxids are inherently small integers, so store them as Int (and the
  // ancestor chain as Int[]) for a compact, index-friendly ~2.7M-row table.
  id        Int      @id @unique
  name      String
  ancestors Int[]
  // A pg_trgm GIN index on `name` (taxonomy_name_trgm) backs the autocomplete's
  // case-insensitive `contains` search. Prisma's schema DSL can't express GIN
  // trigram indexes, so it lives in a raw migration
  // (20260609120000_taxonomy_name_trgm) rather than here.
}

model download {
  id          String    @id @unique
  sequenceIds String[]
  submitted   DateTime
  started     DateTime?
  finished    DateTime?
  results     Bytes? // Results are gzipped on the worker
  log         String?
  err         String?
}

// clustered_nr cluster metadata, sourced from NCBI's cluster sqlite and seeded by
// scripts/migrate-and-seed.js. A clustered_nr BLAST hit is one cluster; these tables
// supply the member list + LCA that the BLAST XML doesn't carry, joined by the
// representative accession.
//
// `representative` is the saccver form (e.g. "XP_013375972.1" for standard accessions,
// bare "0405229A" for legacy IDs) stored VERBATIM from the source. The hit's join key
// is derived as the saccver form too — versions must never be stripped, or every
// versioned-standard cluster silently fails to match.

model cluster_lca {
  representative String @id
  lcaTaxid       Int? // empty for some clusters in the source
}

model cluster_member {
  // Surrogate PK: (representative, accession) could in principle repeat in the source,
  // and a surrogate keeps the server-side COPY seed from ever failing on a dup key.
  id             Int     @id @default(autoincrement())
  representative String
  accession      String
  taxid          Int?
  title          String

  @@index([representative]) // forward enrichment lookup: rep -> members
  @@index([accession]) // reverse lookup: member -> cluster
}
